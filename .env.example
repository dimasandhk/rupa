# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/local"

# Public URL of the app (used by auth). Dev: http://localhost:5173.
# With `docker compose --profile app`, set APP_URL instead (ORIGIN is derived from it).
ORIGIN="http://localhost:5173"
# APP_URL="https://design.example.com"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# S3-compatible storage (RustFS locally; any S3 / R2 / MinIO in production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="canva"
S3_ACCESS_KEY="rustfsadmin"
S3_SECRET_KEY="rustfsadmin"
# Optional public/CDN base URL for objects. When empty, files are served through the app at /files/*
S3_PUBLIC_URL=""

# Stock photos (optional — panels show a hint when unset)
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# Background removal: "browser" (free, in-browser) or "api" (fal.ai, needs FAL_KEY)
PUBLIC_BG_REMOVAL_PROVIDER="browser"
FAL_KEY=""
